# ══════════════════════════════════════════════════════════
#  CryptoGames AutoBot — Environment Configuration
#  Copy to .env and fill in your values:
#    cp .env.example .env && nano .env
# ══════════════════════════════════════════════════════════

# ── CryptoGames API ────────────────────────────────────
# API key — get from https://crypto.games → Account → API Keys
# The key is passed in the URL path (not headers)
CRYPTOGAMES_API_KEY=

# API base URL (override only if needed)
# CRYPTOGAMES_API_BASE=https://api.crypto.games

# ── File Paths (optional, sensible defaults) ─────────────
# CRYPTOGAMES_DB_PATH=~/.cryptogames_autobot.db
# CRYPTOGAMES_CONFIG_PATH=~/.cryptogames_autobot.json
# CRYPTOGAMES_STATE_PATH=~/.cryptogames_autobot_live.json
# CRYPTOGAMES_PID_PATH=~/.cryptogames_autobot.pid
# CRYPTOGAMES_PRESET_PATH=~/.cryptogames_presets.json
# CRYPTOGAMES_LOG_DIR=~/.cryptogames_logs

# ── Telegram Bot ─────────────────────────────────────────
# Get this from @BotFather on Telegram (see setup guide below)
CRYPTOGAMES_TG_TOKEN=

# Directory for per-user Telegram data (DB, config, presets)
# Default: ~/.cryptogames_tg
# CRYPTOGAMES_TG_DATA=~/.cryptogames_tg

# ══════════════════════════════════════════════════════════
#  TELEGRAM SETUP GUIDE
# ══════════════════════════════════════════════════════════
#
#  1. Open Telegram and search for @BotFather
#  2. Send /newbot
#  3. Choose a display name (e.g. "CryptoGames AutoBot")
#  4. Choose a username (must end in "bot", e.g. "cryptogames_autobot_bot")
#  5. BotFather replies with your bot token — paste it above
#  6. Optional: Send /setdescription to BotFather to set a description
#  7. Optional: Send /setcommands to BotFather and paste:
#
#     start - Show welcome and quick start guide
#     help - Full command reference
#     setkey - Set CryptoGames API key
#     balance - Check balances
#     config - View current config
#     set - Set a parameter
#     strategies - List strategies
#     bet - Start betting session
#     stop - Stop session
#     pause - Pause betting
#     resume - Resume betting
#     status - Live status with refresh button
#     stats - Session history
#     lastbets - Recent bets
#     rules - List current rules
#     addrule - Add a rule (JSON)
#     clearrules - Clear all rules
#     presets - List presets
#     savepreset - Save current config as preset
#     loadpreset - Load a preset
#
# ══════════════════════════════════════════════════════════
